---
import { Image } from "astro:assets";
import link from "../../public/svg/link.svg";
import { Tooltip } from "react-tooltip";

const projects = [
  {
    title: "Ooink.me",
    href: "No disponible",
    description:
      "Web application for encoding and managing public links, designed to facilitate the exchange of links. The main challenge of this project was to develop an efficient system for generating and redirecting unique codes associated with links, utilizing an optimized database to manage the creation and storage of these connections. This solution significantly enhances the ease of sharing links securely and in an organized manner.",
    imageSrc: "/images/ooink-me.png",
    imageAlt: "Ooink.me project",
  },
  {
    title: "Cosmee",
    href: "https://cosmeeworld.com/",
    description:
      "Web application for cosmetic recommendations based on personalized diagnostics. Users complete a series of questions that generate a detailed analysis of their skin type and needs. This analysis is complemented by an AI study of their facial features, identifying the main problem areas. The results include graphs and specific product recommendations optimized to address the identified needs, providing a completely personalized and data-driven experience.",
    imageSrc:
      "https://firebasestorage.googleapis.com/v0/b/cosmee-world-web.appspot.com/o/images%2Fcosmeeworld-skincare.jpg?alt=media&token=22301b8e-1401-4289-9e8a-069a3daaed17",
    imageAlt: "Cosmee project",
  },
  {
    title: "Ecommerce",
    href: "https://backend-ecommerce-1-f4tm.onrender.com",
    description:
      "Backend service designed for the eCommerce sector, developed using NodeJS, ExpressJS, and MongoDB for the database. It includes product CRUD operations, advanced filtering options, user authentication and registration with role-based categories, and purchase creation functionalities.",
    imageSrc: "/svg/backend.svg",
    imageAlt: "Ecommerce project",
  },
];

const isOoink = (name: string) => {
  if (name === "Ooink.me") return "No disponible";
};
---

<div
  class="bg-[#1212124D] h-[333px] text-white border border-[#393939] rounded-[32px] p-4 sm:p-8 flex flex-col gap-5 w-full hover:shadow-md hover:shadow-[#393939] transition-shadow">
  <h2 class="font-bold text-xl">Portfolio</h2>
  <div class="h-[400px] w-full pr-4 overflow-y-auto">
    <div class="flex flex-col gap-8">
      {
        projects.map((project, index) => (
          <div
            key={index}
            class="flex flex-col sm:flex-row gap-4 items-center sm:items-start">
            <div class="flex-1 space-y-3">
              <div
                class="flex gap-3 w-fit tooltip tooltip-right tooltip-primary"
                data-tip={isOoink(project.title)}>
                <a
                  href={project.href}
                  target="_blank"
                  class="font-semibold text-xl hover:underline hover:font-light transition-all">
                  {project.title}
                </a>
                <Image src={link} alt={"link"} width={15} height={0} />
              </div>
              <p class="font-normal text-sm text-[#858585]">{project.description}</p>
            </div>
            <div class="bg-[#1D1D1D] rounded-2xl p-[10px] w-full sm:w-[250px]">
              <Image
                src={project.imageSrc}
                alt={project.imageAlt}
                width={250}
                height={151}
                class="w-min mx-auto h-auto sm:h-[151px] rounded-lg object-cover"
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
